  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D E:\MCU\esp32\p4\xiaozhi-for-p4\build_ninja\esp-idf\esp_driver_dac && C:\Users\30817\.espressif\tools\cmake\3.30.2\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

